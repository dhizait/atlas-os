<#
.SYNOPSIS
PS25 Script: PS102-Create-Audit-Batches-125
.DESCRIPTION
INPUT: All PS*.ps1 files in batch-01 to batch-20
PROCESSING: Groups scripts into batches and generates PS25-COMBINED-GROUPING-DOC.md
OUTPUT: PS25-COMBINED-GROUPING-DOC.md + batch folders
STACK: PowerShell
COMPLIANCE: PS25 Documentation
.NOTES
Generated: 2026-08-06
Replaces: PS102-Create-Audit-Batches
#>

param([string]$BasePath = "C:\Atlas\releases\R01\demo-bank")
$ErrorActionPreference = "Stop"
Write-Host "=== PS102: Creating Audit Batches for 125 Scripts ===" -ForegroundColor Cyan

$docPath = Join-Path $BasePath "PS25-COMBINED-GROUPING-DOC.md"

$docContent = @'
